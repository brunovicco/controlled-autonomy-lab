APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=controlled-autonomy-lab

# Required only for live architecture-pattern runs.
# Never commit a real value.
# ANTHROPIC_API_KEY=

# Optional. Pinned canonical model IDs are preferred for repeatable comparisons.
CLAUDE_MODEL=claude-sonnet-5

# Optional Langfuse tracing from the original harness (not used by the lab runtime by default).
# Leave unset to keep tracing disabled. Requires `uv sync --extra tracing`.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
