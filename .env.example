# Select one provider: anthropic, openai, groq, openrouter, custom.
LLM_PROVIDER=openrouter
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=30

# Anthropic
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# OpenAI
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Groq. A Free Plan is available; current default is tool-calling capable.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter. `openrouter/free` routes to currently available free models.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Any HTTPS endpoint implementing compatible /chat/completions + function calling.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://example.com/v1
# OPENAI_COMPAT_MODEL=your-model

# Optional semantic judge overrides (v2.2).
# When omitted, semantic evaluation keeps the v2.1 self-judge behavior and reuses the generator
# provider/model/limits. Provider API keys also fall back to the non-namespaced key, so a separate
# credential is optional rather than required.
# SEMANTIC_LLM_PROVIDER=groq
# SEMANTIC_LLM_MAX_TOKENS=600
# SEMANTIC_LLM_TIMEOUT_SECONDS=20
# SEMANTIC_GROQ_MODEL=openai/gpt-oss-20b
# SEMANTIC_GROQ_API_KEY=
# Other supported model/key overrides follow the same pattern, for example:
# SEMANTIC_OPENAI_MODEL=gpt-5.6-luna
# SEMANTIC_OPENAI_API_KEY=
# SEMANTIC_CLAUDE_MODEL=claude-sonnet-5
# SEMANTIC_ANTHROPIC_API_KEY=
# SEMANTIC_OPENROUTER_MODEL=openrouter/free
# SEMANTIC_OPENROUTER_API_KEY=
# SEMANTIC_OPENAI_COMPAT_MODEL=your-judge-model
# SEMANTIC_OPENAI_COMPAT_BASE_URL=https://example.com/v1
# SEMANTIC_OPENAI_COMPAT_API_KEY=
